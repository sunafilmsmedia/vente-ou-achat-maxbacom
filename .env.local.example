# ─── Vendre avant d'acheter ou l'inverse ? (vente-ou-achat-maxbacon) ────
# Copier vers .env.local et remplir au déploiement.

# Optionnel — sans clé, l'app utilise le rapport déterministe de fallback
# (le verdict, lui, est TOUJOURS calculé par lib/scoring.ts).
ANTHROPIC_API_KEY=

# Webhook CRM (GHL) — sans URL, les leads sont seulement logés côté serveur
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# URL publique du déploiement (metadataBase / Open Graph)
NEXT_PUBLIC_SITE_URL=

# Clarity Scanner — nom de projet (défaut : BRAND.slug de lib/brand.ts)
NEXT_PUBLIC_CLARITY_SCANNER_PROJECT=

# ─── À personnaliser AUSSI (hors .env) ──────────────────────────────────
# lib/brand.ts   → nom, région/ville, textes du hero, logos, courtier(s)
# lib/regions.ts → liste des villes/secteurs couverts
# app/globals.css → palette (bloc @theme) si autre chose que noir/doré/blanc
# public/        → logo-equipe.svg, logo-banniere.svg, broker-1.svg (placeholders génériques)

# ─── À câbler dans le code au déploiement (per-déploiement) ─────────────
# Meta Pixel ID    → components/MetaPixel.tsx  (const PIXEL_ID)
# Clarity Project  → components/Clarity.tsx    (CLARITY_PROJECT_ID)
# Les deux sont vides par défaut : aucun script n'est injecté tant qu'ils
# ne sont pas renseignés.
